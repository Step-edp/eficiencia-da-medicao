# Copie para .env local (não commitar)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/eficiencia_medicao
JWT_SECRET=troque-por-um-segredo-forte
# Origens permitidas para login/API compartilhada (separadas por vírgula)
# Ex.: http://localhost:5173,https://seu-controle.up.railway.app
CORS_ORIGINS=
PORT=3000

# --- E-mail (reprovação de cadastro etc.) ---
# Configure Resend OU SMTP. Sem isso, a reprovação funciona mas não envia e-mail.

# Opção 1: Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Eficiência da Medição <noreply@seu-dominio.com>

# Opção 2: SMTP (ex. Office 365)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seu.usuario@edp.com.br
# SMTP_PASS=sua-senha-ou-app-password
# EMAIL_FROM=Eficiência da Medição <noreply@edp.com.br>
# SMTP_FROM= (alias opcional de EMAIL_FROM)
