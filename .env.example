# Copie para .env local (não commitar)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/eficiencia_medicao
JWT_SECRET=troque-por-um-segredo-forte
# Origens permitidas para login/API compartilhada (separadas por vírgula)
# Ex.: http://localhost:5173,https://seu-controle.up.railway.app
CORS_ORIGINS=
PORT=3000

# --- E-mail (reprovação de cadastro etc.) ---
# Configure Resend OU SMTP. Sem isso, a reprovação funciona mas não envia e-mail.
# Após configurar no Railway, teste com: POST /api/mail/test (admin) { "to": "seu@edp.com.br" }

# Opção 1: Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Eficiência da Medição <noreply@seu-dominio.com>

# Opção 2: Office 365 / EDP (recomendado)
# Peça à TI: caixa compartilhada ou conta de serviço com SMTP AUTH habilitado.
# Com MFA, use "senha de app" do Microsoft Entra (não a senha normal de login).
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=portal.medicao@edp.com.br
# SMTP_PASS=senha-de-app-gerada-pela-ti
# EMAIL_FROM=Eficiência da Medição <portal.medicao@edp.com.br>

# --- Inventário / IQ09 ---
# Comando executado ao clicar no play da etapa IQ09.
# Use {month} para o mês (AAAA-MM), ou o mês será passado como último argumento.
# Exemplos:
# IQ09_SCRIPT_COMMAND=powershell -NoProfile -ExecutionPolicy Bypass -File "C:\scripts\iq09.ps1" -Month {month}
# IQ09_SCRIPT_COMMAND=node ./scripts/iq09.mjs {month}
# IQ09_SCRIPT_COMMAND=
#
# Caminho da planilha .xlsx gerada pelo script (mesmas colunas do export SAP).
# Se vazio, usa data/iq09-export-sample.xlsx quando existir.
# IQ09_EXPORT_PATH=C:\Users\E706032\Downloads\EXPORT - 2026-07-21T164536.402.xlsx
# IQ09_EXPORT_PATH=
